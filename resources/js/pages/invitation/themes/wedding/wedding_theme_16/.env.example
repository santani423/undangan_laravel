# Leave empty to use the clearly-labelled local demo mode (data stays on the guest's device).
# RSVP: POST JSON { guestName, attendance, attendees, message, invitation } (+ Idempotency-Key header)
VITE_RSVP_ENDPOINT=
# Guestbook: GET ?invitation=<slug> → [{ id, name, message, createdAt }], POST { name, message, invitation }
VITE_GUESTBOOK_ENDPOINT=
