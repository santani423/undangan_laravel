# ─── Undesia frontend ─────────────────────────────────────────────────────────
# Base URL of the Laravel REST API (always ends with /api/v1).
#   Development (Vite proxy, same origin): /api/v1
#   Production (separate API host):       https://api.undesia.com/api/v1
VITE_API_BASE_URL=/api/v1

# Origin of the Laravel backend, for the few browser redirects that go to it
# directly (Google login, Sanctum CSRF cookie, guest-list exports).
# Leave empty to derive it from VITE_API_BASE_URL.
#   Production: https://api.undesia.com
VITE_BACKEND_URL=

# Brand name used in page titles.
VITE_APP_NAME=Undesia

# Development only: where `npm run dev` proxies /api, /sanctum, /storage… to.
VITE_DEV_BACKEND_URL=http://127.0.0.1:8000
